# ===== PrivateDrop 配置 =====
# 部署前必填（compose 校验为空即报错）
APP_PASSWORD=please-change-me-strong-password
JWT_SECRET=please-change-me-long-random-secret

# 数据库（db 容器内部密码，与应用 DATABASE_URL 保持一致）
POSTGRES_PASSWORD=privatedrop

# MinIO 凭证（必填，不能是默认的 minioadmin/minioadmin，否则应用启动校验拒绝）
MINIO_ROOT_USER=please-change-me-minio-user
MINIO_ROOT_PASSWORD=please-change-me-minio-password

# 浏览器可达的 MinIO 地址（host:port，用于生成预签名上传/下载 URL，默认 localhost:9000）
# 部署在别的机器上时改成你的域名或 IP，如 minio.example.com:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000

# 桶名
MINIO_BUCKET=privatedrop

# 单文件/条目总大小上限（字节），默认 5GiB
MAX_FILE_SIZE=5368709120

# 预签名 URL 有效期（秒），默认 900（15 分钟）
UPLOAD_URL_TTL_SECONDS=900

# ===== 本地开发（根目录 .env，gitignored）=====
# APP_PASSWORD / JWT_SECRET 必填非占位值，否则后端启动即报错
# DATABASE_URL=postgresql+asyncpg://privatedrop:privatedrop@localhost:5432/privatedrop
# MINIO_ENDPOINT=localhost:9000
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
