# ===== PrivateDrop 配置 =====
# 部署前必填（compose 校验为空即报错）
APP_PASSWORD=please-change-me-strong-password
JWT_SECRET=please-change-me-long-random-secret

# 数据库（db 容器内部密码，与应用 DATABASE_URL 保持一致）
POSTGRES_PASSWORD=privatedrop

# 本地文件存储路径（默认 ./data/storage）
STORAGE_PATH=./data/storage

# 单文件/条目总大小上限（字节），默认 5GiB
MAX_FILE_SIZE=5368709120

# 临时下载链接有效期（秒），默认 900（15 分钟）
UPLOAD_URL_TTL_SECONDS=900

# ===== 本地开发（根目录 .env，gitignored）=====
# APP_PASSWORD / JWT_SECRET 必填非占位值，否则后端启动即报错
# DATABASE_URL=postgresql+asyncpg://privatedrop:privatedrop@localhost:5432/privatedrop
# STORAGE_PATH=./data/storage
